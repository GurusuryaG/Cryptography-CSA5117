#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char plaintext[100];

    char key[] = "QWERTYUIOPASDFGHJKLZXCVBNM";

    printf("Enter the plaintext: ");
    fgets(plaintext, sizeof(plaintext), stdin);

    printf("Encrypted Text: ");

    for (int i = 0; plaintext[i] != '\0'; i++) {
        char ch = plaintext[i];

        if (isupper(ch)) {
            printf("%c", key[ch - 'A']);
        }
        else if (islower(ch)) {
            printf("%c", tolower(key[ch - 'a']));
        }
        else {
            printf("%c", ch);
        }
    }

    return 0;
}
