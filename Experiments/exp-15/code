from collections import Counter

cipher = input("Enter Ciphertext: ").upper()

english = "ETAOINSHRDLCUMWFGYPBVKJXQZ"

print("\nTop 10 Possible Plaintexts\n")

for key in range(10):

    plain = ""

    for ch in cipher:

        if ch.isalpha():

            p = (ord(ch)-65-key)%26

            plain += chr(p+65)

        else:

            plain += ch

    print("Key =", key, "->", plain)
