from collections import Counter

cipher = input("Enter ciphertext: ").upper()

english_frequency = 'E'
freq = Counter(c for c in cipher if c.isalpha())

most_common = freq.most_common(1)[0][0]

cipher_value = ord(most_common) - 65
plain_value = ord('E') - 65

key = (cipher_value - plain_value) % 26

print("Estimated key:", key)

plaintext = ""

for ch in cipher:
    if ch.isalpha():
        c = ord(ch) - 65
        p = (c - key) % 26
        plaintext += chr(p + 65)
    else:
        plaintext += ch

print("Possible plaintext:", plaintext)
