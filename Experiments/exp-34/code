message = input("Enter message: ")

block_size = 8
data = message.encode()

padding = block_size - (len(data) % block_size)

if padding == 0:
    padding = block_size

data += b'\x80' + b'\x00' * (padding - 1)

print("Original:", message)
print("Padded:", data)
print("Padding bytes:", padding)

print("\nReason for always padding:")
print("It avoids ambiguity between real data and padding.")
