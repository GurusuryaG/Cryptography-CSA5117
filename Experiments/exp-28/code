q = int(input("Enter public prime q: "))
a = int(input("Enter public base a: "))

xa = int(input("Enter Alice's secret x: "))
xb = int(input("Enter Bob's secret y: "))

A = pow(a, xa, q)
B = pow(a, xb, q)

key_alice = pow(B, xa, q)
key_bob = pow(A, xb, q)

print("Alice sends:", A)
print("Bob sends:", B)

print("Alice key:", key_alice)
print("Bob key:", key_bob)

if key_alice == key_bob:
    print("Shared key established:", key_alice)
